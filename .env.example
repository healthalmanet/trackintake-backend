# ==============================================================================
# TrackIntake Backend Environment Variables
# Duplicate this file as .env and fill in your actual credentials.
# ==============================================================================

# --- Django & Security Settings ---
PYTHON_VERSION=3.12.7
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<dbname>?sslmode=require

# --- Cache / Redis ---
REDIS_URL=rediss://default:<password>@<host>:<port>

# --- Google Gemini AI API ---
# Generate key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- OAuth Providers (Google & Facebook) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_SECRET=your_facebook_app_secret

# --- Media Storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Payment Gateway (Razorpay) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Communication & Notifications (Twilio & Resend) ---
ACCOUNT_SID=your_twilio_account_sid
AUTH_TOKEN=your_twilio_auth_token
MOBILE_NUMBER=+91XXXXXXXXXX
RESEND_API_KEY=re_your_resend_api_key

# --- Third-party & Microservice Integrations ---
PATHYATECH_API_SECRET=your_pathyatech_api_secret
PATHYATECH_BACKEND_URL=https://healthcare-cz6u.onrender.com
